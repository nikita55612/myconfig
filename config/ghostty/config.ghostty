# title = ""
# macos-titlebar-style = transparent
# macos-window-buttons = hidden
# window-subtitle = false
# window-decoration = auto
confirm-close-surface = false
custom-shader = shaders/cursor_tail.glsl
custom-shader = shaders/ripple_cursor.glsl
mouse-hide-while-typing = true
shell-integration-features = no-cursor
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true
cursor-style = block
cursor-style-blink = false
font-size = 22
font-family = ZedMono Nerd Font Mono
font-style = Bold
palette = 0=#151515
palette = 1=#b46958
palette = 2=#90a959
palette = 3=#f4bf75
palette = 4=#bad7ff
palette = 5=#aa759f
palette = 6=#88afa2
palette = 7=#e1e1e1
palette = 8=#727272
palette = 9=#7e97ab
palette = 10=#90a959
palette = 11=#f4bf75
palette = 12=#bad7ff
palette = 13=#aa759f
palette = 14=#88afa2
palette = 15=#afafaf
background = #101010
foreground = #e0e1e4
cursor-color = #e0e1e4
cursor-text = #18191b
selection-background = #696d79
selection-foreground = #e0e1e4
palette = 16=#d49467
palette = 17=#cba59d
